# Copy file này thành .env rồi sửa. File .env đã nằm trong .gitignore, không commit lên Git.

POSTGRES_PASSWORD=doi-mat-khau-nay
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Khóa ký JWT, tối thiểu 32 ký tự và phải khó đoán. Tạo bằng: openssl rand -base64 48
# Ai có khóa này thì tự làm ra token hợp lệ cho bất kỳ ai, kể cả ADMIN. Đừng chia sẻ hay commit.
JWT_SECRET=

# Tài khoản ADMIN đầu tiên (tùy chọn). Chỉ tạo nếu email chưa tồn tại.
# Mật khẩu 8 ký tự trở lên. Sau lần chạy đầu nên xóa BOOTSTRAP_ADMIN_PASSWORD khỏi file này.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
